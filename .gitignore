# Throwaway conversion experiments and test output - regenerable, not final content.
scratch/

# LaTeX/tex4ht intermediates. make-course.sh copies the source into build/ and
# compiles there, so the build directory accumulates .dvi/.aux/.log/.pdf next to
# the pages we actually publish. Only the web output belongs in the repo.
courses/*/build/*.aux
courses/*/build/*.dvi
courses/*/build/*.idv
courses/*/build/*.lg
courses/*/build/*.log
courses/*/build/*.tmp
courses/*/build/*.toc
courses/*/build/*.xref
courses/*/build/*.4ct
courses/*/build/*.4tc
courses/*/build/*.tex
courses/*/build/*.pdf
courses/*/build/*.synctex.gz

# The same LaTeX artefacts also appear beside the source when the .tex is
# compiled in place. Only intro_prob.tex belongs in source/.
courses/*/source/*.pdf
courses/*/source/*.synctex.gz
courses/*/source/*.toc
courses/*/source/*.aux
courses/*/source/*.log
courses/*/source/*.out
